---
import "../styles/global.scss";
import Header from "../components/navigation/Header.astro";
import Footer from "../components/navigation/Footer.astro";
import ScrollReveal from "../components/global/ScrollReveal.astro";
import { Font } from "astro:assets";
import {
  getLocaleFromPath,
  getLocalizedPath,
  stripLocaleFromPath,
} from "../i18n/translations";

interface Props {
  pageTitle: string;
  description: string;
  canonicalPath?: string;
}

const { pageTitle, description, canonicalPath } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const routePath = stripLocaleFromPath(canonicalPath ?? Astro.url.pathname);
const canonicalURL = new URL(getLocalizedPath(routePath, locale), Astro.site);
const englishURL = new URL(getLocalizedPath(routePath, "en"), Astro.site);
const spanishURL = new URL(getLocalizedPath(routePath, "es"), Astro.site);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-noto-sans" preload />
    <Font cssVariable="--font-noto-serif" preload />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} | TrueCare RCM360 Solutions</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="en" href={englishURL.href} />
    <link rel="alternate" hreflang="es" href={spanishURL.href} />
    <link rel="alternate" hreflang="x-default" href={englishURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ScrollReveal />
  </body>
</html>
