---
import Main from "../layouts/Main.astro";
import Hero from "../components/home/hero/Hero.astro";
import Banner from "../components/home/banner/Banner.astro";
import WhatWeDo from "../components/home/whatWeDo/WhatWeDo.astro";
import WhyUs from "../components/home/whyUs/WhyUs.astro";
import OurProcess from "../components/home/process/OurProcess.astro";
import Faq from "../components/global/Faq.astro";
import Contact from "../components/contact/Contact.astro";
import ConsultationButton from "../components/global/ConsultationButton.astro";
import { getLocaleFromPath, getTranslations } from "../i18n/translations";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const copy = t.home;
---

<Main
  pageTitle={copy.metaTitle}
  description={copy.metaDescription}
>
  <Hero />
  <Banner
    primaryText={copy.careBanner.primary}
    secondaryText={copy.careBanner.secondary}
    color="#0b2b3d"
    justify="center"
    icon="/assets/icons/heart.svg"
  />
  <WhatWeDo />
  <Banner
    primaryText={copy.cashFlowBanner.primary}
    secondaryText={copy.cashFlowBanner.secondary}
    textAlign="flex-start"
    color="#5a7964"
    justify="space-between"
    icon="/assets/icons/peopleGroup.svg"
  >
    <ConsultationButton
      slot="action"
      cta={t.common.consultation}
      variant="secondary"
      showIcon={false}
    />
  </Banner>
  <WhyUs />
  <OurProcess />
  <Faq
    id="faq"
    title={copy.faqTitle}
    description={copy.faqDescription}
    items={copy.faqItems}
  />
  <Contact />
</Main>
