---
import Main from "../layouts/Main.astro";

const team = [
  {
    name: "Elizabeth",
    role: "Founder & RCM Specialist",
    description: [
      "With more than 25 years of experience in finance, financial analysis, accounts receivable, billing, pricing, and customer operations, I bring a strong analytical foundation and a passion for helping businesses succeed. Throughout my career, I’ve worked across banking, manufacturing, transportation, media, and consumer goods, developing expertise in financial reporting, revenue analysis, billing accuracy, process improvement, and team leadership.",
      "My experience has taught me that every successful organization depends on efficient systems, accurate financial processes, and attention to detail. After spending decades helping businesses improve operations, analyze financial performance, and strengthen revenue processes, I chose to transition into medical billing to apply those same skills in a field where I can make a meaningful difference.",
      "Today, I combine my background in finance, accounts receivable, billing, and financial analysis with a commitment to helping healthcare providers maintain healthy revenue cycles. My goal is to provide accurate, dependable medical billing services so providers can spend less time worrying about administrative tasks and more time focusing on their patients.",
    ],
    color: "green",
  },
  {
    name: "Lizbeth",
    role: "Billing & Client Support",
    description: [
      "With a master’s degree in sociology, a bachelor’s degree in sociology and psychology, and a minor in Spanish, I bring a unique combination of analytical, research, and interpersonal skills.",
      "While my focus is medical billing, I also have experience in data analytics and enjoy using data to identify patterns, improve processes, and support better decision-making. Whether that’s through business analytics or evaluating patient outcomes, I believe data can be a powerful tool for helping organizations grow. My goal is to provide accurate, reliable medical billing while bringing an analytical perspective that adds value beyond the day-to-day.",
    ],
    color: "navy",
  },
];
---

<style>
  .about-page {
    background: var(--primary-white);
    color: var(--primary-navy);

    h1,
    h2,
    h3 {
      color: var(--primary-navy);
      font-family: var(--font-noto-serif);
    }

    h1 {
      max-width: 780px;
      margin: 0;
      font-size: clamp(2.35rem, 2.5vw, 4.25rem);
      line-height: 1.05;
    }

    .about-intro,
    .team-section {
      padding: 5rem 1.5rem;

      @media (width <= 760px) {
        padding: 4rem 1rem;
      }
    }

    .about-intro {
      background:
        linear-gradient(rgb(248 248 248 / 86%), rgb(248 248 248 / 26%)),
        url("/img/gradient.jpeg") center / cover no-repeat;

      border-bottom: 4px solid var(--primary-gold);
    }

    .container {
      width: min(100%, 1180px);
      margin: 0 auto;
    }

    .eyebrow,
    .team-role {
      color: var(--primary-green);
      font-size: 0.86rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 0.75rem;
    }

    .title-divider,
    .card-divider {
      height: 3px;
      border-radius: 999px;
      background: var(--primary-gold);
    }

    .title-divider {
      width: 76px;
      margin: 1.25rem 0 2.5rem;
    }

    .card-divider {
      width: 54px;
      margin: 0.9rem 0 1.15rem;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: minmax(240px, 0.9fr) minmax(0, 1.3fr);
      align-items: stretch;
      overflow: hidden;
      border-radius: 28px;
      background: var(--primary-white);
      box-shadow: 0 12px 28px rgb(9 33 59 / 12%);

      @media (width <= 760px) {
        grid-template-columns: 1fr;
      }
    }

    .team-card {
      /* border: 1px solid var(--primary-green); */
      border-radius: 28px;
      box-shadow: 0 12px 28px rgb(9 33 59 / 12%);
    }

    .image-placeholder {
      min-height: 290px;
      overflow: hidden;
      background: var(--primary-green);
    }

    .intro-image {
      min-height: 280px;
      height: auto;
      vertical-align: middle;
      font-style: italic;
      background-repeat: no-repeat;
      background-size: cover;
      shape-margin: 1rem;
      background-image: url(/img/AboutImage.PNG);

      @media (width <= 760px) {
        min-height: 240px;
        border-right: 0;
        border-bottom: 1px solid var(--primary-green);
      }
    }

    .content-card {
      padding: clamp(1.75rem, 4vw, 3.25rem);
      align-self: center;
      background: var(--primary-white);

      h2 {
        margin: 0;
        font-size: clamp(1.85rem, 2vw, 2.75rem);
        line-height: 1.1;
      }

      p {
        margin: 0;
        font-size: clamp(0.96rem, 1vw, 1.05rem);
        line-height: 1.65;
      }

      p + p {
        margin-top: 1rem;
      }
    }

    .team-section {
      background: var(--primary-white);
      /* position: relative;
      isolation: isolate;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: url("/img/gradient.jpeg") center / cover no-repeat;
        opacity: 0.2;
        max-width: 100%;
        height: auto;
        vertical-align: middle;
        shape-margin: 1rem;
      } */
    }

    .section-heading {
      max-width: 620px;

      h2 {
        margin: 0;
        font-size: clamp(1.85rem, 2vw, 2.75rem);
        line-height: 1.1;
      }
    }

    .team-list {
      display: grid;
      gap: 1.5rem;
    }

    .team-card {
      display: grid;
      grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
      overflow: hidden;
      background: var(--primary-white);

      .image-placeholder {
        min-height: 280px;
        border: 0;
        border-radius: 0;
        box-shadow: none;

        &.is-navy {
          background: var(--primary-navy);
        }

        @media (width <= 760px) {
          min-height: 240px;
          border-right: 0;
          border-bottom: 1px solid var(--primary-green);
        }
      }

      @media (width <= 760px) {
        grid-template-columns: 1fr;
      }
    }

    .team-copy {
      align-self: center;
      padding: clamp(1.75rem, 4vw, 3rem);

      h3 {
        margin: 0;
        font-size: clamp(1.6rem, 2vw, 2.25rem);
        line-height: 1.1;
      }

      .description p {
        margin: 0;
        font-size: clamp(0.96rem, 1vw, 1.05rem);
        /* line-height: 1.65; */
      }

      .description p + p {
        margin-top: 1rem;
      }

      .team-role {
        margin: 0 0 0.55rem;
      }
    }
  }
</style>

<Main pageTitle="About Us">
  <main class="about-page">
    <section class="about-intro" aria-labelledby="about-title">
      <div class="container">
        <!-- <span class="eyebrow">About Us</span> -->
        <h1 id="about-title">About TrueCare RCM 360 Solutions</h1>
        <div class="title-divider" aria-hidden="true"></div>

        <div class="intro-grid">
          <div
            class="image-placeholder intro-image"
            role="img"
            aria-label="TrueCare team image placeholder"
          >
          </div>

          <article class="content-card">
            <h2>Support built around your practice</h2>
            <div class="card-divider" aria-hidden="true"></div>
            <p>
              TrueCare RCM 360 Solutions supports healthcare practices with
              organized, dependable revenue cycle management. Our goal is to
              make the billing process easier to understand and easier to
              manage.
            </p>
            <p>
              This is a starting point for your story. You can add more about
              your experience, your values, and what led you to create TrueCare
              as the page develops.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="team-section" aria-labelledby="team-title">
      <div class="container">
        <header class="section-heading">
          <span class="eyebrow">Meet the people behind the work</span>
          <h2 id="team-title">Our Team</h2>
          <div class="title-divider" aria-hidden="true"></div>
        </header>

        <div class="team-list">
          {
            team.map((member) => (
              <article class="team-card">
                <div
                  class:list={["image-placeholder", `is-${member.color}`]}
                  role="img"
                  aria-label={`${member.name} portrait placeholder`}
                />
                <div class="team-copy">
                  <p class="team-role">{member.role}</p>
                  <h3>{member.name}</h3>
                  <div class="card-divider" aria-hidden="true" />
                  <div class="description">
                    {member.description.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Main>
