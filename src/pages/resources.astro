---
import Main from "../layouts/Main.astro";
import PageHero from "../components/global/PageHero.astro";
import Faq from "../components/global/Faq.astro";
import PageCTA from "../components/global/PageCTA.astro";
import {
  getLocaleFromPath,
  getLocalizedPath,
  getTranslations,
} from "../i18n/translations";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const copy = t.resources;
---

<style>
  .resources-page {
    --error-red: #b42318;

    background: var(--primary-white);
    color: var(--primary-navy);

    h2,
    h3 {
      margin: 0;
      font-family: var(--font-noto-serif);
      line-height: 1.1;
    }

    p {
      line-height: 1.65;
    }

    .container {
      width: min(100%, 1180px);
      margin-inline: auto;
    }

    .library {
      padding: clamp(4rem, 7vw, 6rem) 1.5rem;
      background:
        linear-gradient(rgb(248 248 248 / 86%), rgb(248 248 248 / 28%)),
        url("/img/gradient.jpeg") center / cover no-repeat;
    }

    .library-intro {
      display: flex;
      margin-bottom: clamp(2rem, 4vw, 3rem);
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }

    .library-heading {
      max-width: 42rem;

      .eyebrow {
        display: inline-block;
        margin-bottom: 0.75rem;
        color: var(--primary-green);
        font-size: var(--font-size-eyebrow);
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1.3;
        text-transform: uppercase;
      }

      h2 {
        font-size: var(--font-size-section);
        text-wrap: balance;
      }

      p {
        margin: 1.25rem 0 0;
        font-size: var(--font-size-lead);
      }
    }

    .directory {
      display: flex;
      gap: clamp(1rem, 2vw, 1.5rem);
      align-items: stretch;
    }

    .resource-panel {
      position: relative;
      display: flex;
      flex: 1 1 0;
      min-width: 0;
      min-height: 31rem;
      padding: clamp(1.5rem, 2.5vw, 2rem);
      overflow: hidden;
      flex-direction: column;
      border: 1px solid var(--border-color);
      border-radius: 28px;
      background: rgb(255 255 255 / 92%);
      box-shadow: 0 14px 34px rgb(9 33 59 / 9%);
    }

    .panel-number {
      margin: 0 0 2rem;
      color: var(--primary-green);
      font-family: var(--font-noto-sans);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.14em;
    }

    .panel-heading {
      h3 {
        font-size: var(--font-size-feature);
        text-wrap: balance;
      }

      p {
        min-height: 5.2rem;
        margin: 1rem 0 1.5rem;
        color: color-mix(in srgb, var(--primary-navy) 78%, white);
        font-size: var(--font-size-body);
      }
    }

    .resource-list {
      display: flex;
      margin: auto 0 0;
      padding: 0;
      flex-direction: column;
      border-top: 1px solid
        color-mix(in srgb, var(--primary-navy) 16%, transparent);
      list-style: none;

      li {
        border-bottom: 1px solid
          color-mix(in srgb, var(--primary-navy) 16%, transparent);
      }
    }

    .resource-link {
      position: relative;
      display: flex;
      min-height: 4.25rem;
      padding: 0.9rem 0;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      color: var(--primary-navy);
      font-size: var(--font-size-body);
      font-weight: 600;
      line-height: 1.35;
      cursor: not-allowed;
      transition:
        color 160ms ease,
        padding 160ms ease;

      &:focus-visible {
        border-radius: 4px;
        outline: 2px solid var(--primary-gold);
        outline-offset: 3px;
      }

      &:is(:hover, :focus-visible) {
        padding-inline: 0.35rem;
        color: var(--error-red);

        .link-arrow {
          opacity: 0;
          transform: translateX(0.35rem);
        }

        .coming-soon {
          opacity: 1;
          transform: translateX(0);
          animation: invalid-nudge 260ms ease both;
        }
      }
    }

    .link-status {
      position: relative;
      display: inline-flex;
      flex: 0 0 5.5rem;
      min-height: 1.2rem;
      align-items: center;
      justify-content: flex-end;
    }

    .link-arrow,
    .coming-soon {
      position: absolute;
      right: 0;
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    .link-arrow {
      color: var(--primary-green);
      font-size: 1.05rem;
    }

    .coming-soon {
      opacity: 0;
      color: var(--error-red);
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transform: translateX(-0.35rem);
      white-space: nowrap;
    }

    .utility-rail {
      display: flex;
      flex: 0 0 auto;
      justify-content: flex-end;
      gap: 1rem;
    }

    .utility-link {
      position: relative;
      display: flex;
      flex: 0 0 4.75rem;
      width: 4.75rem;
      aspect-ratio: 1;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      border: 1px solid var(--border-color);
      border-radius: 18px;
      background: #fff;
      color: var(--primary-navy);
      box-shadow: 0 10px 24px rgb(9 33 59 / 10%);
      text-decoration: none;
      transition:
        background-color 160ms ease,
        color 160ms ease,
        transform 160ms ease;

      svg {
        width: 1.55rem;
        height: 1.55rem;
        stroke: currentColor;
      }

      .utility-label {
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        line-height: 1;
        text-transform: uppercase;
      }

      &:hover {
        background: var(--primary-green);
        color: white;
        transform: translateY(-2px);
      }

      &:focus-visible {
        outline: 2px solid var(--primary-gold);
        outline-offset: 4px;
      }
    }

    @media (width <= 1040px) {
      .directory {
        flex-wrap: wrap;
      }

      .resource-panel {
        flex-basis: calc(50% - 0.75rem);
      }
    }

    @media (width <= 700px) {
      .library {
        padding: 4rem 1rem;
      }

      .library-intro {
        flex-direction: column;
        align-items: stretch;
        gap: 1.5rem;
      }

      .utility-rail {
        align-self: flex-end;
      }

      .directory {
        flex-direction: column;
      }

      .resource-panel {
        min-height: 0;
      }

      .panel-heading {
        p {
          min-height: 0;
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .resource-link,
      .resource-link span,
      .utility-link,
      .utility-link svg {
        transition: none;
        animation: none;
      }
    }
  }

  @keyframes invalid-nudge {
    0%,
    100% {
      translate: 0;
    }

    30% {
      translate: -0.22rem;
    }

    65% {
      translate: 0.18rem;
    }
  }
</style>

<Main
  pageTitle={copy.metaTitle}
  description={copy.metaDescription}
>
  <main class="resources-page">
    <PageHero
      eyebrow={copy.heroEyebrow}
      title={copy.heroTitle}
      description={copy.heroDescription}
      image="/img/WhyUs.jpg"
      imagePosition="35% 55%"
    />

    <section class="library" aria-labelledby="library-title">
      <div class="container">
        <div class="library-intro">
          <header class="library-heading">
            <span class="eyebrow">{copy.libraryEyebrow}</span>
            <h2 id="library-title">{copy.libraryTitle}</h2>
            <p>{copy.libraryDescription}</p>
          </header>

          <aside class="utility-rail" aria-label={copy.shortcutsLabel}>
            <a
              class="utility-link"
              href="#faq"
              aria-label={copy.faqShortcut}
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M9.6 9a2.6 2.6 0 1 1 4.3 2c-1.3 1-1.9 1.5-1.9 3"
                  stroke-width="1.8"
                  stroke-linecap="round"></path>
                <path d="M12 18h.01" stroke-width="2.4" stroke-linecap="round"
                ></path>
                <circle cx="12" cy="12" r="9" stroke-width="1.8"></circle>
              </svg>
              <span class="utility-label">{copy.faqLabel}</span>
            </a>

            <a
              class="utility-link"
              href={getLocalizedPath("/#contact", locale)}
              aria-label={copy.contactShortcut}
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M7.1 3.4 4.9 4.9c-.9.6-1.2 1.8-.8 2.8 2.2 5.7 6.5 10 12.2 12.2 1 .4 2.2.1 2.8-.8l1.5-2.2c.5-.8.4-1.9-.4-2.5l-2.8-2.1c-.7-.5-1.7-.5-2.3.1l-1.5 1.5a13.1 13.1 0 0 1-3.5-3.5l1.5-1.5c.6-.6.6-1.6.1-2.3L9.6 3.8c-.6-.8-1.7-.9-2.5-.4Z"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="utility-label">{copy.contact}</span>
            </a>
          </aside>
        </div>

        <div class="directory">
          {
            copy.groups.map((group, groupIndex) => (
              <article class="resource-panel">
                <p class="panel-number" aria-hidden="true">
                  {String(groupIndex + 1).padStart(2, "0")}
                </p>
                <div class="panel-heading">
                  <h3>{group.title}</h3>
                  <p>{group.description}</p>
                </div>

                <ul class="resource-list">
                  {group.resources.map((resource) => (
                    <li>
                      <span
                        class="resource-link"
                        role="link"
                        aria-disabled="true"
                        aria-label={`${resource}, ${copy.comingSoonLabel}`}
                        tabindex="0"
                      >
                        <span>{resource}</span>
                        <span class="link-status" aria-hidden="true">
                          <span class="link-arrow">↗</span>
                          <span class="coming-soon">{copy.comingSoon}</span>
                        </span>
                      </span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>

      </div>

    </section>

    <Faq
      id="faq"
      title={copy.faqTitle}
      description={copy.faqDescription}
      items={copy.faqItems}
    />

    <PageCTA
      title={copy.closingTitle}
      description={copy.closingDescription}
      consultationIntro={t.common.consultationIntro}
      topics={copy.closingTopics}
    />
  </main>
</Main>
