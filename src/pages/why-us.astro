---
import Main from "../layouts/Main.astro";
import PageHero from "../components/global/PageHero.astro";
import Button from "../components/global/Button.astro";
import PageCTA from "../components/global/PageCTA.astro";
import {
  getLocaleFromPath,
  getLocalizedPath,
  getTranslations,
} from "../i18n/translations";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const copy = t.whyUsPage;
---

<style>
  .why-us-page {
    background: var(--primary-white);
    color: var(--primary-navy);

    h2,
    h3 {
      margin: 0;
      font-family: var(--font-noto-serif);
      line-height: 1.1;
    }

    p {
      line-height: 1.65;
    }

    .container {
      width: min(100%, 1180px);
      margin-inline: auto;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 0.75rem;
      color: var(--primary-green);
      font-size: var(--font-size-eyebrow);
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .divider {
      width: 76px;
      height: 3px;
      margin: 1.25rem 0;
      border-radius: 999px;
      background: var(--primary-gold);
    }

    .reasons-section,
    .partnership-section {
      padding: 5rem 1.5rem;
    }

    .reasons-section {
      background:
        linear-gradient(rgb(248 248 248 / 86%), rgb(248 248 248 / 26%)),
        url("/img/gradient.jpeg") center / cover no-repeat;

      .container {
        display: flex;
        gap: clamp(3rem, 8vw, 7rem);
        align-items: start;
      }

      .section-heading {
        flex: 1 1 50rem;
        min-width: 0;
        max-width: 30rem;
        margin: 0;

        .buttons {
          margin-top: 1.5rem;
          width: 100%;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: space-evenly;
        }

        h2 {
          font-size: var(--font-size-section);
          text-wrap: balance;
        }

        p {
          margin: 0;
          font-size: var(--font-size-lead);
        }
      }

      .reason-list {
        display: flex;
        flex: 1 1 36rem;
        flex-direction: column;
        min-width: 0;
        margin: 0;
        padding: 0;
        gap: 0;
        list-style: none;

        border-top: 1px solid
          color-mix(in srgb, var(--primary-navy) 20%, transparent);

        .reason {
          display: flex;
          flex: 1 1 0;
          box-sizing: border-box;
          /* min-height: 11.5rem; */
          padding: 2rem 0;
          gap: clamp(1rem, 2vw, 1.75rem);
          align-items: start;
          border-bottom: 1px solid
            color-mix(in srgb, var(--primary-navy) 20%, transparent);

          .number {
            flex: 0 0 clamp(2.75rem, 4vw, 3.5rem);
            margin: 0;
            color: var(--primary-green);
            font-family: var(--font-noto-sans);
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            line-height: 1.4;
          }

          .reason-copy {
            display: flex;
            flex: 1;
            flex-direction: column;
            min-width: 0;
            gap: 0.8rem;

            h3 {
              font-size: var(--font-size-feature);
              line-height: 1.2;
              text-wrap: balance;
            }

            p {
              position: relative;
              max-width: 34rem;
              margin: 0;
              padding-left: 1.1rem;
              font-size: var(--font-size-body);
              line-height: 1.55;

              &::before {
                content: "";
                position: absolute;
                top: 0.78em;
                left: 0;
                width: 0.38rem;
                height: 0.38rem;
                border-radius: 50%;
                background: var(--primary-gold);
                transform: translateY(-50%);
              }
            }
          }
        }
      }

      @media (width <= 860px) {
        padding: 4rem 1rem;

        .container {
          flex-direction: column;
          gap: 3rem;
        }

        .section-heading {
          flex: none;
          width: 100%;
        }

        .reason-list {
          flex: none;
          width: 100%;
        }
      }

      @media (width <= 520px) {
        .reason-list {
          .reason {
            gap: 0.75rem;

            .number {
              flex-basis: 2.25rem;
            }
          }
        }
      }
    }

    .partnership-section {
      .partnership-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(2rem, 7vw, 6rem);
        align-items: start;
      }

      .partnership-copy {
        h2 {
          font-size: var(--font-size-section);
        }

        p {
          margin: 0;
          font-size: var(--font-size-lead);
        }
      }

      .commitments {
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--primary-green);
        list-style: none;

        li {
          position: relative;
          padding: 1.25rem 0 1.25rem 2rem;
          border-bottom: 1px solid var(--primary-green);
          font-size: var(--font-size-body);
          font-weight: 600;
          line-height: 1.55;
        }

        li::before {
          content: "";
          position: absolute;
          top: 1.65rem;
          left: 0.25rem;
          width: 0.55rem;
          height: 0.3rem;
          border-bottom: 2px solid var(--primary-gold);
          border-left: 2px solid var(--primary-gold);
          transform: rotate(-45deg);
        }
      }

      @media (width <= 760px) {
        padding: 4rem 1rem;

        .partnership-grid {
          grid-template-columns: 1fr;
        }
      }
    }
  }
</style>

<Main
  pageTitle={copy.metaTitle}
  description={copy.metaDescription}
>
  <main class="why-us-page">
    <PageHero
      eyebrow={copy.heroEyebrow}
      title={copy.heroTitle}
      description={copy.heroDescription}
      image="/img/WhyUs.jpg"
      imagePosition="35% 55%"
    />

    <section class="reasons-section" aria-labelledby="difference-title">
      <div class="container">
        <header class="section-heading">
          <span class="eyebrow">{copy.differenceEyebrow}</span>
          <h2 id="difference-title">{copy.differenceTitle}</h2>
          <div class="divider" aria-hidden="true"></div>
          <p>{copy.differenceDescription}</p>
          <div class="buttons">
            <Button
              cta={copy.contactCta}
              href={getLocalizedPath("/#contact", locale)}
            />
          </div>
        </header>

        <ol class="reason-list" role="list">
          {
            copy.reasons.map((reason, index) => (
              <li class="reason">
                <span class="number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="reason-copy">
                  <h3>{reason.title}</h3>
                  <p>{reason.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="partnership-section" aria-labelledby="partnership-title">
      <div class="container partnership-grid">
        <div class="partnership-copy">
          <span class="eyebrow">{copy.partnershipEyebrow}</span>
          <h2 id="partnership-title">{copy.partnershipTitle}</h2>
          <div class="divider" aria-hidden="true"></div>
          <p>{copy.partnershipDescription}</p>
        </div>

        <ul class="commitments" aria-label={copy.commitmentsLabel}>
          {copy.commitments.map((commitment) => <li>{commitment}</li>)}
        </ul>
      </div>
    </section>

    <PageCTA
      title={copy.closingTitle}
      description={copy.closingDescription}
      consultationIntro={t.common.consultationIntro}
      topics={copy.closingTopics}
    />
  </main>
</Main>
