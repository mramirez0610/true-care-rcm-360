---
import {
  getLocaleFromPath,
  getLocalizedPath,
  getTranslations,
} from "../../../i18n/translations";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const copy = t.home.whyUs;
---

<style>
  .why-us {
    padding: 5rem 1.5rem;
    background:
      linear-gradient(rgb(0 0 0 / 62%), rgb(0 0 0 / 62%)),
      url("/img/WhyUs.jpg") center / cover no-repeat;

    .container {
      width: min(100%, 1180px);
      margin: 0 auto;
    }

    .intro {
      max-width: 860px;
      margin: 0 auto 2.25rem;
      text-align: center;

      h2 {
        margin: 0;
        color: var(--primary-white);
        font-family: var(--font-noto-serif);
        font-size: var(--font-size-home-section);
        line-height: 1.1;
      }

      p {
        margin: 0;
        color: var(--primary-white);
        font-size: var(--font-size-lead);
        line-height: 1.65;
      }
    }

    .title-divider {
      width: 76px;
      height: 3px;
      margin: 1rem auto 1.25rem;
      border-radius: 999px;
      background: var(--primary-gold);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .card-link {
      display: block;
      height: 100%;
      border-radius: 28px;
      color: var(--primary-navy);
      text-decoration: none;

      &:hover {
        .card {
          border-color: var(--border-color);
          box-shadow: 0 16px 32px rgba(9, 33, 59, 0.18);
          transform: translateY(-3px);
          scale: 1.01;

          h3 {
            /* color: var(--primary-green); */
          }

          .card-arrow {
            opacity: 1;
            transform: translate(3px, -3px);
          }
        }
      }

      &:focus-visible {
        outline: 2px solid var(--primary-gold);
        outline-offset: 4px;

        .card-arrow {
          opacity: 1;
          transform: translate(3px, -3px);
        }
      }

      .card {
        position: relative;
        box-sizing: border-box;
        display: flex;
        height: 100%;
        min-height: 230px;
        padding: 1.75rem 3.5rem 1.75rem 1.75rem;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        border: 1px solid var(--border-color);
        border-radius: 28px;
        background: var(--primary-white);
        box-shadow: 0 12px 28px rgba(9, 33, 59, 0.12);
        color: var(--primary-navy);
        transition:
          border-color 180ms ease,
          box-shadow 180ms ease,
          transform 180ms ease,
          scale 180ms ease;

        h3 {
          margin: 0;
          font-family: var(--font-noto-serif);
          font-size: var(--font-size-card-title);
          line-height: 1.25;
        }

        p {
          margin: 0;
          color: var(--primary-navy);
          font-size: var(--font-size-body);
          line-height: 1.55;
        }

        .card-arrow {
          position: absolute;
          right: 1.75rem;
          bottom: 1.5rem;
          color: var(--primary-green);
          font-size: 1.15rem;
          line-height: 1;
          opacity: 0.65;
          transition:
            opacity 180ms ease,
            transform 180ms ease;
        }
      }
    }

    .card-divider {
      width: 54px;
      height: 3px;
      margin: 0.85rem 0 1rem;
      border-radius: 999px;
      background: var(--primary-gold);
    }
  }

  @media (max-width: 800px) {
    .why-us {
      .cards {
        grid-template-columns: 1fr;
      }

      .card {
        min-height: 0;
      }
    }
  }

  @media (max-width: 640px) {
    .why-us {
      padding: 4rem 1rem;

      .intro {
        text-align: left;
      }

      .intro {
        margin-bottom: 1.75rem;
      }

      .card {
        padding: 1.5rem;
      }
    }
  }
</style>

<section class="why-us" id="why-us" aria-labelledby="why-us-title">
  <div class="container">
    <header class="intro">
      <h2 id="why-us-title">{copy.title}</h2>
      <div class="title-divider" aria-hidden="true"></div>
      <p>{copy.description}</p>
    </header>

    <div class="cards">
      {
        copy.items.map((reason) => (
          <a
            class="card-link"
            href={getLocalizedPath("/why-us", locale)}
          >
            <article class="card">
              <h3>{reason.title}</h3>
              <div class="card-divider" aria-hidden="true" />
              <p>{reason.description}</p>
              <span class="card-arrow" aria-hidden="true">
                ↗
              </span>
            </article>
          </a>
        ))
      }
    </div>
  </div>
</section>
