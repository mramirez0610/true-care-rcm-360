---
const reasons = [
  {
    title: "Reliable Communication",
    description: "Stay informed with clear updates and responsive support.",
  },
  {
    title: "Clean Claim Focus",
    description: "We work to reduce errors, rejections, and avoidable delays.",
  },
  {
    title: "Practice-Centered Support",
    description:
      "Your billing process is handled with your workflow and goals in mind.",
  },
];
---

<style>
  .why-us {
    padding: 5rem 1.5rem;
    background:
      linear-gradient(rgb(0 0 0 / 62%), rgb(0 0 0 / 62%)),
      url("/img/WhyUs.jpg") center / cover no-repeat;

    .container {
      width: min(100%, 1180px);
      margin: 0 auto;
    }

    .intro {
      max-width: 860px;
      margin: 0 auto 2.25rem;
      text-align: center;

      h2 {
        margin: 0;
        color: var(--primary-white);
        font-family: var(--font-noto-serif);
        font-size: clamp(2rem, 3.4vw, 3rem);
        line-height: 1.1;
      }

      p {
        margin: 0;
        color: var(--primary-white);
        font-size: clamp(0.95rem, 1.2vw, 1.08rem);
        line-height: 1.65;
      }
    }

    .title-divider {
      width: 76px;
      height: 3px;
      margin: 1rem auto 1.25rem;
      border-radius: 999px;
      background: var(--primary-gold);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .card-link {
      display: block;
      height: 100%;
      border-radius: 28px;
      color: var(--primary-navy);
      text-decoration: none;

      &:hover {
        .card {
          border-color: var(--border-color);
          box-shadow: 0 16px 32px rgba(9, 33, 59, 0.18);
          transform: translateY(-3px);
          scale: 1.01;

          h3 {
            /* color: var(--primary-green); */
          }

          .card-arrow {
            opacity: 1;
            transform: translate(3px, -3px);
          }
        }
      }

      &:focus-visible {
        outline: 2px solid var(--primary-gold);
        outline-offset: 4px;

        .card-arrow {
          opacity: 1;
          transform: translate(3px, -3px);
        }
      }

      .card {
        position: relative;
        box-sizing: border-box;
        display: flex;
        height: 100%;
        min-height: 230px;
        padding: 1.75rem 3.5rem 1.75rem 1.75rem;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        border: 1px solid var(--border-color);
        border-radius: 28px;
        background: var(--primary-white);
        box-shadow: 0 12px 28px rgba(9, 33, 59, 0.12);
        color: var(--primary-navy);
        transition:
          border-color 180ms ease,
          box-shadow 180ms ease,
          transform 180ms ease,
          scale 180ms ease;

        h3 {
          margin: 0;
          font-family: var(--font-noto-serif);
          font-size: clamp(1.15rem, 1.55vw, 1.4rem);
          line-height: 1.25;
        }

        p {
          margin: 0;
          color: var(--primary-navy);
          font-size: 0.98rem;
          line-height: 1.55;
        }

        .card-arrow {
          position: absolute;
          right: 1.75rem;
          bottom: 1.5rem;
          color: var(--primary-green);
          font-size: 1.15rem;
          line-height: 1;
          opacity: 0.65;
          transition:
            opacity 180ms ease,
            transform 180ms ease;
        }
      }
    }

    .card-divider {
      width: 54px;
      height: 3px;
      margin: 0.85rem 0 1rem;
      border-radius: 999px;
      background: var(--primary-gold);
    }
  }

  @media (max-width: 800px) {
    .why-us {
      .cards {
        grid-template-columns: 1fr;
      }

      .card {
        min-height: 0;
      }
    }
  }

  @media (max-width: 640px) {
    .why-us {
      padding: 4rem 1rem;

      .intro {
        text-align: left;
      }

      .intro {
        margin-bottom: 1.75rem;
      }

      .card {
        padding: 1.5rem;
      }
    }
  }
</style>

<section class="why-us" id="why-us" aria-labelledby="why-us-title">
  <div class="container">
    <header class="intro">
      <h2 id="why-us-title">Why Practices Choose TrueCare</h2>
      <div class="title-divider" aria-hidden="true"></div>
      <p>
        Billing support you can feel confident in. Your practice deserves
        billing support that is accurate, organized, and handled with care.
        TrueCare helps simplify the revenue cycle so you can focus on your
        patients.
      </p>
    </header>

    <div class="cards">
      {
        reasons.map((reason) => (
          <a class="card-link" href="/why-us">
            <article class="card">
              <h3>{reason.title}</h3>
              <div class="card-divider" aria-hidden="true" />
              <p>{reason.description}</p>
              <span class="card-arrow" aria-hidden="true">
                ↗
              </span>
            </article>
          </a>
        ))
      }
    </div>
  </div>
</section>
