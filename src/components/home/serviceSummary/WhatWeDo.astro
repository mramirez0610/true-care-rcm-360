---
const items = [
  {
    title: "Medical Billing & Coding",
    description: "Accurate coding, clean claims, and faster reimbursement.",
    icon: "✓",
  },
  {
    title: "Claims Submission",
    description: "Timely submission and follow-up so payments arrive sooner.",
    icon: "✓",
  },
  {
    title: "Denial Management",
    description: "Reduce denials, recover revenue, and protect your cash flow.",
    icon: "✓",
  },
];
---

<style>
  .what-we-do {
    padding: 4rem 1.5rem;
    background: var(--primary-white);
  }

  .what-we-do__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .what-we-do__content {
    max-width: 540px;
    margin-bottom: 2rem;
  }

  .what-we-do__eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: var(--primary-green);
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .what-we-do__title {
    margin: 0;
    font-size: 2.75rem;
    line-height: 1.05;
    color: var(--primary-navy);
  }

  .what-we-do__divider {
    width: 10%;
    border: 2px solid var(--primary-gold);
    background: var(--primary-gold);
    margin: 1.25rem 0;
    border-radius: 999px;
  }

  .what-we-do__text {
    margin: 0;
    color: var(--primary-navy);
    line-height: 1.8;
    font-size: 1rem;
  }

  .what-we-do__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .what-we-do__card {
    background: white;
    /* border: 1px solid #dbe2e8; */
    border: 1px solid var(--primary-green);
    border-radius: 28px;
    padding: 1.5rem;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
  }

  .what-we-do__icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #e8f5ec;
    color: #1f4f3e;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .what-we-do__card-title {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    color: #102a43;
  }

  .what-we-do__card-text {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
    font-size: 0.95rem;
  }
</style>

<section class="what-we-do">
  <div class="what-we-do__inner">
    <div class="what-we-do__content">
      <span class="what-we-do__eyebrow">What We Can Do</span>
      <h2 class="what-we-do__title">For You</h2>
      <div class="what-we-do__divider"></div>
      <p class="what-we-do__text">
        Reliable billing support designed to help your practice reduce denials,
        improve cash flow, and spend more time with patients.
      </p>
    </div>

    <div class="what-we-do__grid">
      {
        items.map((item) => (
          <article class="what-we-do__card">
            <div class="what-we-do__icon">{item.icon}</div>
            <h3 class="what-we-do__card-title">{item.title}</h3>
            <p class="what-we-do__card-text">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
