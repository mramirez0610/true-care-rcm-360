---
const items = [
  {
    title: "Medical Billing & Coding",
    description: "Accurate coding, clean claims, and faster reimbursement.",
    icon: "/assets/icons/clipboard.svg",
  },
  {
    title: "Claims Submission",
    description: "Timely submission and follow-up so payments arrive sooner.",
    icon: "/assets/icons/checklist.svg",
  },
  {
    title: "Denial Management",
    description: "Reduce denials, recover revenue, and protect your cash flow.",
    icon: "/assets/icons/cash.svg",
  },
];
---

<style>
  .what-we-do {
    padding: 4rem 1.5rem;
    background: var(--primary-white);
  }

  .what-we-do-inner {
    max-width: 1180px;
    margin: 0 auto;

    /* changes section to row */
    /* display: flex;
    gap: 5%; */
  }

  .what-we-do-content {
    max-width: 540px;
    margin-bottom: 2rem;
  }

  .what-we-do-eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: var(--primary-green);
    font-size: clamp(0.82rem, 1vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .what-we-do-title {
    margin: 0;
    color: var(--primary-navy);
    font-family: var(--font-noto-serif);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
  }

  .what-we-do-divider {
    width: 10%;
    height: 3px;
    background: var(--primary-gold);
    margin: 1.25rem 0;
    border-radius: 999px;
  }

  .what-we-do-text {
    margin: 0;
    color: var(--primary-navy);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.65;
  }

  .what-we-do-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

    /* changes section to row */
    /* grid-auto-flow: column; */
  }

  .what-we-do-card {
    background: white;
    /* border: 1px solid #dbe2e8; */
    border: 1px solid var(--primary-green);
    border-radius: 28px;
    padding: 1.5rem;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
  }

  .what-we-do-icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #e8f5ec;
    color: #1f4f3e;
    font-size: 1.4rem;
    margin-bottom: 1rem;
    padding: 0.5rem;
  }

  .what-we-do-card-title {
    margin: 0 0 0.75rem;
    color: #102a43;
    font-family: var(--font-noto-serif);
    font-size: clamp(1.15rem, 1.55vw, 1.4rem);
    line-height: 1.25;
  }

  .what-we-do-card-text {
    margin: 0;
    color: #64748b;
    font-size: 0.98rem;
    line-height: 1.55;
  }
</style>

<section class="what-we-do">
  <div class="what-we-do-inner">
    <div class="what-we-do-content">
      <span class="what-we-do-eyebrow">What We Can Do</span>
      <h2 class="what-we-do-title">For You</h2>
      <div class="what-we-do-divider"></div>
      <p class="what-we-do-text">
        Reliable billing support designed to help your practice reduce denials,
        improve cash flow, and spend more time with patients.
      </p>
    </div>

    <div class="what-we-do-grid">
      {
        items.map((item) => (
          <article class="what-we-do-card">
            <img src={item.icon} class="what-we-do-icon" />
            <h3 class="what-we-do-card-title">{item.title}</h3>
            <p class="what-we-do-card-text">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
