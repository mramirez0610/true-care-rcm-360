---
const {
  primaryText = "",
  secondaryText = "",
  color = "#0b2b3d",
  colorText = "#f8f8f8",
  textAlign = "center",
  justify = "center", // "flex-start" | "center" | "flex-end" | "space-between"
  cta = null,
  icon = null,
} = Astro.props;
import Button from "../../global/Button.astro";

const copyTextAlign =
  textAlign === "flex-start"
    ? "start"
    : textAlign === "flex-end"
      ? "end"
      : textAlign;
const hasActionSlot = Astro.slots.has("action");
---

<style>
  .cta-banner {
    width: 100%;
    background: var(--bg);
    color: var(--fg);
    display: flex;
    justify-content: center;
    padding: 1.5rem 0;
    font-weight: 600;
    font-size: 0.95rem;

    .cta-banner-content {
      width: min(100%, max(60%, 50rem));
      max-width: 1200px;
      display: flex;
      align-items: center;
      justify-content: var(--justify);
      gap: clamp(1rem, 3vw, 2rem);
      padding-inline: 1rem;

      .cta-banner-left {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: clamp(0.75rem, 2vw, 1rem);

        .cta-banner-icon {
          display: block;
          flex: 0 0 auto;
          max-width: clamp(3rem, 6vw, 3.8125rem);
          height: auto;
        }

        .cta-banner-text {
          min-width: 0;
          display: flex;
          flex-direction: column;
          align-items: var(--items-align);
          gap: 0.35rem;
          line-height: 1.3;
          text-align: var(--copy-align);

          .primary-text {
            font-size: 1.15em;
            margin: 0;
            text-wrap: balance;
          }

          .secondary-text {
            text-wrap: balance;
          }
        }
      }

      .cta-banner-action {
        display: flex;
        flex: 0 0 250px;
        justify-content: center;
      }

      @media (max-width: 900px) {
        flex-direction: column;
        gap: 1rem;
        text-align: center;

        .cta-banner-left {
          width: 100%;
          justify-content: center;

          .cta-banner-text {
            align-items: center;
            text-align: center;
          }
        }

        .cta-banner-action {
          flex: 0 0 auto;
          width: 100%;
        }
      }

      @media (max-width: 559px) {
        .cta-banner-action :global(.button) {
          width: 100%;
          height: 3.25rem;
        }
      }
    }
  }
</style>

<div
  class="cta-banner"
  role="region"
  style={`--bg: ${color}; --fg: ${colorText}; --justify: ${justify};`}
>
  <div class="cta-banner-content">
    <div class="cta-banner-left">
      {
        icon ? (
          <img src={icon} alt="" class="cta-banner-icon" />
        ) : (
          <slot name="icon" />
        )
      }
      <div
        class="cta-banner-text"
        style={`--items-align: ${textAlign}; --copy-align: ${copyTextAlign};`}
      >
        <slot />
        <p class="primary-text">{primaryText}</p>
        <div class="secondary-text">{secondaryText}</div>
      </div>
    </div>

    {
      (cta || hasActionSlot) && (
        <div class="cta-banner-action">
          {hasActionSlot ? (
            <slot name="action" />
          ) : (
            <Button
              cta={cta.text}
              href={cta.href || "#"}
              variant={cta.variant}
              icon={cta.icon}
            />
          )}
        </div>
      )
    }
  </div>
</div>
