---
import HeroImg from "./HeroImg.astro";
import HeroInfo from "./HeroInfo.astro";
---

<style>
  .hero {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    z-index: 1;
    isolation: isolate;
    background:
      linear-gradient(rgb(248 248 248 / 65%), rgb(248 248 248 / 65%)),
      url("/img/gradient.jpeg") center / cover no-repeat;

    @media (min-width: 1600px) {
      min-height: 55vh;
    }

    @media (max-width: 900px) {
      display: block;
      min-height: max(46rem, calc(100svh - var(--header-size)));
    }

    @media (max-width: 900px) {
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;

        /* gradient for visibility */

        background: linear-gradient(
          to bottom,
          rgba(236, 243, 238, 0.87) 78%,
          rgba(248, 248, 248, 0.94) 100%
        );
      }
    }

    @media (max-width: 900px) and (orientation: landscape) {
      min-height: 42rem;
    }
  }
</style>

<header class="hero">
  <HeroInfo />
  <HeroImg />
</header>
