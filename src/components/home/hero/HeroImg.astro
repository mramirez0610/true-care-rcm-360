<style>
  .hero-image {
    width: 50%;
    align-self: stretch;

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left center;
    }

    @media (max-width: 900px) {
      position: absolute;
      inset: 0;
      z-index: 1;
      width: 100%;
      height: 100%;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
    }
  }
</style>

<div class="hero-image">
  <img
    src="/img/HeroImage.png"
    alt="A medical billing specialist helping a family"
    width="780"
    height="543"
    fetchpriority="high"
  />
</div>
