---
import Button from "../../global/Button.astro";
---

<style>
  .hero-block {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(2rem, 4vw, 4.5rem);
    gap: clamp(1rem, 2vh, 1.5rem);

    .header {
      h1 {
        font-size: clamp(2.5rem, 4.1vw, 4.6rem);
        line-height: 1.04;
        letter-spacing: -0.035em;
        font-weight: 500;
        width: 100%;
        text-align: left;
        margin: 0;

        &:nth-child(2) {
          color: var(--primary-green);
        }
      }
    }

    .divider {
      width: clamp(4.5rem, 30%, 9rem);
      height: 3px;
      border: 0;
      border-radius: 999px;
      background: var(--primary-gold);
    }

    .sub-header {
      width: min(100%, 38rem);

      h2 {
        margin: 0;
        font-weight: 500;
        font-size: clamp(1.15rem, 1.55vw, 1.6rem);
        line-height: 1.35;
        text-align: left;
        font-family: var(--font-noto-serif);
      }
    }

    .cta-section {
      max-width: 43rem;

      p {
        margin: 0;
        font-size: clamp(1rem, 1.15vw, 1.125rem);
        line-height: 1.65;
      }
    }

    .cta-buttons {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    @media (min-width: 1600px) {
      width: 50%;
      padding: 0 8%;
      gap: 2vh;
    }

    @media (max-width: 900px) {
      position: relative;
      z-index: 3;
      width: 100%;
      min-height: max(42rem, calc(100svh - var(--header-size)));
      justify-content: center;
      padding: clamp(2.5rem, 9vw, 4.5rem) clamp(1.25rem, 6vw, 3rem);
      gap: 1rem;

      .header {
        h1 {
          font-size: clamp(2.1rem, 9.5vw, 3rem);
          line-height: 1.06;
        }
      }

      .sub-header {
        h2 {
          font-size: clamp(1.125rem, 4.8vw, 1.4rem);
          line-height: 1.4;
        }
      }

      .cta-section {
        p {
          font-size: 1rem;
          line-height: 1.6;
        }
      }

      .cta-buttons {
        flex-direction: column;
        align-items: stretch;
        margin-top: 0.25rem;
      }

      .cta-buttons :global(.button) {
        width: 100%;
        height: 3.25rem;
      }
    }

    @media (min-width: 560px) and (max-width: 900px) {
      .cta-buttons {
        flex-direction: row;
      }
    }

    @media (max-width: 900px) and (orientation: landscape) {
      min-height: 42rem;
    }
  }
</style>

<section class="hero-block">
  <section class="header">
    <h1>Turning Claims</h1>
    <h1>Into Consistent Cash Flow</h1>
  </section>
  <div class="divider"></div>
  <section class="sub-header">
    <h2>
      Reliable Medical Billing Solutions That Help Your Practice Get Paid Faster
    </h2>
  </section>
  <section class="cta-section">
    <p>
      At TrueCare RCM360 Solutions, we take the complexities of billing off your
      plate so you can focus on what matters most, your patients.
    </p>
  </section>
  <section class="cta-buttons">
    <Button
      cta="Get a Free Consultation"
      ,
      href="#contact"
      ,
      icon="/assets/icons/calendar.svg"
    />
    <Button cta="Our Services" variant="secondary" />
  </section>
</section>
