---
import Button from "../global/Button.astro";
import ContactDetails from "./ContactDetails.astro";
---

<style>
  .contact {
    --panel-radius: 8px;
    --control-radius: 7px;
    --interaction-speed: 160ms;

    padding: clamp(4rem, 7vw, 6.5rem) 1.5rem clamp(7rem, 11vw, 10rem);
    border-top: 3px solid var(--primary-gold);
    background: var(--primary-white);
    color: var(--primary-navy);

    .container {
      width: min(100%, 1180px);
      margin-inline: auto;
    }

    .intro {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
      gap: 3rem;
      align-items: start;
      margin-block-end: 2.5rem;

      h2 {
        width: fit-content;
        margin: 0;
        font-family: var(--font-noto-serif);
        font-size: clamp(2rem, 3.4vw, 3rem);
        line-height: 1.1;
        text-decoration: underline;
        text-decoration-color: var(--primary-green);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.2em;
      }

      p {
        max-width: 32rem;
        margin: 0;
        font-size: clamp(0.95rem, 1.2vw, 1.08rem);
        line-height: 1.65;
      }
    }

    .columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: start;
    }

    .panel {
      padding: clamp(1.5rem, 3vw, 2.25rem);
      border: 2px solid var(--primary-green);
      border-radius: var(--panel-radius);
      background: #fff;

      h3 {
        margin: 0;
        font-family: var(--font-noto-serif);
        font-size: clamp(1.5rem, 2.2vw, 2rem);
        line-height: 1.2;
      }
    }

    .panel-divider {
      width: 100%;
      height: 3px;
      margin-block: 1rem 1.5rem;
      border-radius: 999px;
      background: var(--primary-gold);
    }

    form {
      display: grid;
      gap: 1.1rem;

      .field-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .field {
        display: grid;
        gap: 0.42rem;
      }

      label {
        color: var(--primary-navy);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      :is(input, textarea) {
        width: 100%;
        border: 1px solid
          color-mix(in srgb, var(--primary-navy) 65%, transparent);
        border-radius: var(--control-radius);
        background: #f7f7f7;
        color: var(--primary-navy);
        font: inherit;
        font-size: 0.9rem;
        transition:
          border-color var(--interaction-speed) ease,
          box-shadow var(--interaction-speed) ease,
          background-color var(--interaction-speed) ease;

        &::placeholder {
          color: color-mix(in srgb, var(--primary-navy) 38%, white);
        }

        &:focus {
          border-color: var(--primary-green);
          outline: none;
          background: #fff;
          box-shadow: 0 0 0 3px
            color-mix(in srgb, var(--primary-green) 22%, transparent);
        }
      }

      input {
        min-height: 2.65rem;
        padding: 0.65rem 0.75rem;
      }

      textarea {
        min-height: 9rem;
        padding: 0.75rem;
        resize: vertical;
      }

      .submit {
        min-width: 13.5rem;
        min-height: 2.65rem;
        justify-self: start;
        padding: 0.7rem 1.5rem;
        border: 0;
        border-radius: var(--control-radius);
        background: var(--primary-gold);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          transform var(--interaction-speed) ease,
          filter var(--interaction-speed) ease,
          box-shadow var(--interaction-speed) ease;

        &:hover {
          filter: brightness(0.94);
          transform: translateY(-1px);
          box-shadow: 0 8px 18px rgb(9 33 59 / 14%);
        }

        &:focus-visible {
          outline: 2px solid var(--primary-navy);
          outline-offset: 3px;
        }
      }
    }

    .info-panel {
      :global(.details) {
        margin-block-end: 1.65rem;
      }
    }

    .info-cta {
      display: flex;
      justify-content: center;

      :global(.button) {
        width: min(100%, 18rem);
        height: 2.8rem;
        border: 0;
        border-radius: var(--control-radius);
        font-size: 0.78rem;
        box-shadow: none;
      }
    }

    @media (width <= 800px) {
      .intro {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .columns {
        grid-template-columns: 1fr;
      }
    }

    @media (width <= 560px) {
      padding-inline: 1rem;
      padding-block-end: 6rem;

      .intro {
        margin-block-end: 2rem;
      }

      form {
        .field-row {
          grid-template-columns: 1fr;
        }

        .submit {
          width: 100%;
          min-width: 0;
        }
      }

      .panel {
        padding: 1.35rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :is(input, textarea, .submit) {
        transition: none;
      }
    }
  }
</style>

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <header class="intro">
      <h2 id="contact-title">Contact Us</h2>
      <p>
        If you have any questions, please feel free to get in touch with us via
        phone, email, or the form below.
      </p>
    </header>

    <div class="columns">
      <div class="panel">
        <h3>Get in touch</h3>
        <div class="panel-divider" aria-hidden="true"></div>
        <form>
          <div class="field-row">
            <div class="field">
              <label for="contact-name">Name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Enter your name *"
                required
              />
            </div>
            <div class="field">
              <label for="contact-phone">Phone Number</label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder="Enter your phone number *"
                required
              />
            </div>
          </div>

          <div class="field">
            <label for="contact-email">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="Enter your email address *"
              required
            />
          </div>

          <div class="field">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              placeholder="Enter your message *"
              required></textarea>
          </div>

          <button class="submit" type="submit">Send Message</button>
        </form>
      </div>

      <aside class="panel info-panel" aria-labelledby="contact-info-title">
        <h3 id="contact-info-title">Contact Info</h3>
        <div class="panel-divider" aria-hidden="true"></div>
        <ContactDetails />
        <div class="info-cta">
          <Button
            cta="GET A FREE CONSULTATION"
            href="#contact"
            icon="/assets/icons/calendar.svg"
          />
        </div>
      </aside>
    </div>
  </div>
</section>
