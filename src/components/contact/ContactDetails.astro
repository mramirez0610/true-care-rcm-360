---
const { compact = false } = Astro.props;

const details = [
  {
    label: "Phone",
    value: "+1 (123) 456 7890",
    href: "tel:+11234567890",
    icon: "phone",
  },
  {
    label: "Email",
    value: "truecarercm360solutions@gmail.com",
    href: "mailto:elizabeth@truecarercm360solutions.com",
    icon: "email",
  },
  {
    label: "Office Hours",
    value: "Mon - Fri, 9 AM - 5 PM",
    icon: "clock",
  },
];
---

<style>
  .details {
    display: grid;
    gap: 1.15rem;
    margin: 0;

    .detail {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.8rem;
      align-items: center;
    }

    .icon {
      display: grid;
      width: 2rem;
      aspect-ratio: 1;
      place-items: center;
      color: var(--primary-green);

      svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
      }
    }

    dt {
      margin-block-end: 0.18rem;
      color: var(--primary-navy);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    dd {
      margin: 0;
      color: var(--primary-navy);
      font-size: 0.9rem;
      font-weight: 700;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--primary-green);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      &:focus-visible {
        border-radius: 2px;
        outline: 2px solid var(--primary-gold);
        outline-offset: 3px;
      }
    }

    &.compact {
      gap: 0.8rem;

      .detail {
        grid-template-columns: 1.65rem minmax(0, 1fr);
        gap: 0.75rem;
      }

      .icon {
        width: 1.65rem;
      }

      dt {
        font-size: 0.62rem;
      }

      dd {
        font-size: 0.72rem;
      }
    }
  }
</style>

<dl class:list={["details", { compact }]}>
  {
    details.map((detail) => (
      <div class="detail">
        <span class="icon" aria-hidden="true">
          {detail.icon === "phone" && (
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M7.1 3.4 4.9 4.9c-.9.6-1.2 1.8-.8 2.8 2.2 5.7 6.5 10 12.2 12.2 1 .4 2.2.1 2.8-.8l1.5-2.2c.5-.8.4-1.9-.4-2.5l-2.8-2.1c-.7-.5-1.7-.5-2.3.1l-1.5 1.5a13.1 13.1 0 0 1-3.5-3.5l1.5-1.5c.6-.6.6-1.6.1-2.3L9.6 3.8c-.6-.8-1.7-.9-2.5-.4Z"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
          {detail.icon === "email" && (
            <svg viewBox="0 0 24 24" fill="none">
              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="2"
                stroke-width="1.7"
              />
              <path
                d="m4.5 7 6.2 5a2 2 0 0 0 2.6 0l6.2-5"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
          {detail.icon === "clock" && (
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" stroke-width="1.7" />
              <path
                d="M12 7v5l3.2 1.8"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </span>
        <div>
          <dt>{detail.label}</dt>
          <dd>
            {detail.href ? (
              <a href={detail.href}>{detail.value}</a>
            ) : (
              detail.value
            )}
          </dd>
        </div>
      </div>
    ))
  }
</dl>
