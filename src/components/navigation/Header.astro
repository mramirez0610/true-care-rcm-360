---
import Navigation from "./Navigation.astro";
import MobileButton from "./MobileButton.astro";
import ConsultationButton from "../global/ConsultationButton.astro";
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocaleFromPath, getTranslations } from "../../i18n/translations";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
---

<style lang="scss">
  header {
    width: 100%;
    height: var(--header-size);
    background-color: var(--primary-white);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-around;

    position: sticky;
    top: 0;
    left: 0;

    box-shadow:
      0px 1px 3px 3px rgba(0, 0, 0, 0.3),
      0px 4px 8px 3px rgba(0, 0, 0, 0.15);
    // padding: 2% 5%;

    @media (min-width: 901px) and (max-width: 1180px) {
      :global(.nav) {
        width: 58%;
      }

      .header-cta {
        display: none;
      }
    }

    @media (max-width: 900px) {
      padding-inline: 1rem;
      justify-content: space-between;

      :global(.logo-link) {
        position: absolute;
        z-index: 12;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        height: 65%;
      }

      .header-cta {
        display: none;
      }
    }
  }
</style>

<header>
  <LanguageSwitcher />
  <Logo />
  <MobileButton />
  <Navigation />
  <div class="header-cta">
    <ConsultationButton cta={t.common.consultationShort} />
  </div>
</header>
