<style>
  .mobile-button {
    display: none;
    position: relative;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    background: transparent;
    border: none;
    border-radius: 0.25rem;
    color: var(--primary-navy);

    cursor: pointer;
    width: 2.75rem;
    height: 2.75rem;
  }

  .mobile-button span {
    position: absolute;
    width: 1.75rem;
    height: 2px;
    background: currentColor;
    transition:
      transform 250ms ease,
      opacity 200ms ease;
  }

  .mobile-button span:first-child {
    transform: translateY(-0.35rem);
  }

  .mobile-button span:last-child {
    transform: translateY(0.35rem);
  }

  .mobile-button[aria-expanded="true"] span:first-child {
    transform: rotate(45deg);
  }

  .mobile-button[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .mobile-button[aria-expanded="true"] span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-button:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .mobile-button {
      display: inline-flex;
      z-index: 12;
    }
  }
</style>

<button
  type="button"
  aria-expanded="false"
  aria-controls="main-menu"
  aria-label="Open main menu"
  class="mobile-button"
  id="mobile-button"
>
  <span aria-hidden="true"></span>
  <span aria-hidden="true"></span>
  <span aria-hidden="true"></span>
</button>
