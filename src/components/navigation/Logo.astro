---
import { getLocaleFromPath, getLocalizedPath } from "../../i18n/translations";

const locale = getLocaleFromPath(Astro.url.pathname);
---

<style lang="scss">
  .logo-link {
    display: inline-flex;
    height: 80%;
    align-items: center;
    line-height: 0;

    .logo {
      display: block;
      width: auto;
      height: 100%;
    }
  }
</style>

<a class="logo-link" href={getLocalizedPath("/", locale)}>
  <img
    class="logo"
    src="/assets/logoComplete.svg"
    alt="TrueCare RCM360 Solutions"
  />
</a>
