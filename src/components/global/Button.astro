---
interface Props {
  cta: string;
  href?: string;
  icon?: string;
  variant?: "primary" | "secondary";
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  cta,
  href = "#",
  icon,
  variant = "primary",
  target,
  rel,
  ariaLabel,
} = Astro.props;
---

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5%;
    width: 250px;
    height: 50px;
    border-radius: 10px;
    border: 2px solid var(--primary-navy);
    text-decoration: none;
    font-size: 0.833rem;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
  }

  .button:not(.button--secondary) {
    background: var(--primary-green);
    color: var(--primary-white);
    border-color: var(--primary-green);
  }

  .button--secondary {
    background: var(--primary-white);
    color: var(--primary-navy);
    border-color: var(--primary-navy);
  }

  .button span {
    white-space: nowrap;
  }
</style>

<a
  class={`button ${variant === "secondary" ? "button--secondary" : ""}`}
  href={href}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
>
  {
    icon ? (
      <img src={icon} alt="" class="cta-banner-icon" />
    ) : (
      <slot name="icon" />
    )
  }
  <span>{cta}</span>
</a>
