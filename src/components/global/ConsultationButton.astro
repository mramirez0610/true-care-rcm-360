---
import Button from "./Button.astro";
import { getLocaleFromPath, getTranslations } from "../../i18n/translations";

interface Props {
  cta?: string;
  variant?: "primary" | "secondary";
  showIcon?: boolean;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);

const {
  cta = t.common.consultation,
  variant = "primary",
  showIcon = true,
} = Astro.props;

const consultationUrl = "https://calendly.com/marcoramirezmail/30min";
---

<Button
  cta={cta}
  href={consultationUrl}
  icon={showIcon ? "/assets/icons/calendar.svg" : undefined}
  variant={variant}
  target="_blank"
  rel="noopener noreferrer"
  ariaLabel={`${cta} (${t.common.opensNewTab})`}
/>
